{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRUST404 Track 1 결과 형식",
  "description": "입력된 Solidity 파일마다 분석 결과 객체 하나를 JSON 배열에 담아 stdout으로 출력합니다.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/finding" },

  "$defs": {
    "finding": {
      "type": "object",
      "required": ["file", "verdict", "reasons", "evidence"],
      "additionalProperties": true,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\\\r\\n]+\\.sol(?![\\s\\S])",
          "description": "디렉터리 경로를 제외한 입력 파일명입니다. .sol로 끝나며 입력 파일명과 정확히 일치해야 합니다.",
          "examples": ["P2_HiddenMint.sol"]
        },
        "verdict": {
          "enum": ["MALICIOUS", "BENIGN", "UNCERTAIN"],
          "description": "대문자로 표기된 세 값 중 하나를 사용해야 합니다."
        },
        "reasons": {
          "type": "array",
          "minItems": 0,
          "items": { "type": "string", "minLength": 1 },
          "description": "판정 근거입니다. 빈 배열은 허용되지만 이유 타당성 점수를 받을 수 없습니다."
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/evidenceItem" },
          "description": "근거가 되는 코드 위치입니다. BENIGN과 UNCERTAIN은 빈 배열을 허용하며, MALICIOUS는 항목이 하나 이상 필요합니다."
        },
        "risk_level": {
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
          "description": "선택 필드입니다. 자동 채점에는 사용하지 않습니다."
        },
        "risk_type": {
          "enum": ["BACKDOOR", "VULNERABILITY", "CENTRALIZATION", "NONE"],
          "description": "선택 필드입니다. 자동 채점에는 사용하지 않습니다."
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "선택 필드입니다. 0.0부터 1.0 사이의 값을 사용합니다."
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "verdict": { "const": "MALICIOUS" } },
            "required": ["verdict"]
          },
          "then": {
            "properties": { "evidence": { "minItems": 1 } }
          }
        }
      ]
    },

    "evidenceItem": {
      "type": "object",
      "anyOf": [
        { "required": ["function"] },
        { "required": ["line"] }
      ],
      "additionalProperties": true,
      "description": "function과 line 중 하나 이상을 포함해야 합니다.",
      "properties": {
        "function": {
          "type": "string",
          "minLength": 1,
          "description": "근거가 있는 함수명입니다."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "입력 파일을 기준으로 한 1부터 시작하는 줄 번호입니다. 파일 범위를 벗어난 값은 이유 타당성 평가에서 감점될 수 있습니다."
        }
      }
    }
  }
}
